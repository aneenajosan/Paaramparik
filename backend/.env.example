# Server Configuration
PORT=4000
NODE_ENV=development

# Database Configuration (PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/living_culture_map?schema=public"

# JWT Authentication
JWT_SECRET="super-secret-jwt-token-key-for-living-culture-map-2026"
JWT_EXPIRES_IN="7d"

# CORS
CORS_ORIGIN="http://localhost:3000"

# Real Email Delivery Configuration
# To send real verification emails to actual inboxes (e.g. Gmail / Outlook / Yahoo):
# Option A: Gmail SMTP (easiest):
# 1. Generate an App Password at https://myaccount.google.com/apppasswords
# 2. Put your full Gmail address and 16-character app password below:
EMAIL_USER=""
EMAIL_PASS=""

# Option B: Custom SMTP (e.g., Resend, Brevo, SendGrid, AWS SES):
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT=587
# SMTP_USER=""
# SMTP_PASS=""
# SMTP_SECURE="false"
